  <vhdl appearance="logisim_evolution" name="Instruction_Decoder">library ieee;
use ieee.std_logic_1164.all;

entity Instruction_Decoder is
    port (
        op             : in  std_logic_vector(5 downto 0);
        funct          : in  std_logic_vector(5 downto 0);
        is_R           : out std_logic;
        is_addi_type   : out std_logic;
        is_logical_imm : out std_logic;
        is_lui         : out std_logic;
        is_lw          : out std_logic;
        is_lb          : out std_logic;
        is_lbu         : out std_logic;
        is_sw          : out std_logic;
        is_sb          : out std_logic;
        is_beq         : out std_logic;
        is_bne         : out std_logic;
        is_j           : out std_logic;
        is_jal         : out std_logic;
        is_jr          : out std_logic;
        is_syscall     : out std_logic;
        is_illegal     : out std_logic;
        alu_op_R       : out std_logic_vector(2 downto 0);
        imm_zero_ext   : out std_logic;
        load_unsigned  : out std_logic;
        mem_byte       : out std_logic
    );
end entity Instruction_Decoder;

architecture Behavioral of Instruction_Decoder is
    signal s_R           : std_logic;
    signal s_addi_type   : std_logic;
    signal s_logical_imm : std_logic;
    signal s_lui         : std_logic;
    signal s_lw          : std_logic;
    signal s_lb          : std_logic;
    signal s_lbu         : std_logic;
    signal s_sw          : std_logic;
    signal s_sb          : std_logic;
    signal s_beq         : std_logic;
    signal s_bne         : std_logic;
    signal s_j           : std_logic;
    signal s_jal         : std_logic;
    signal s_jr          : std_logic;
    signal s_syscall     : std_logic;
    signal s_illegal     : std_logic;
    signal s_alu_op      : std_logic_vector(2 downto 0);
begin
    process (op, funct)
    begin
        s_R           &lt;= '0';
        s_addi_type   &lt;= '0';
        s_logical_imm &lt;= '0';
        s_lui         &lt;= '0';
        s_lw          &lt;= '0';
        s_lb          &lt;= '0';
        s_lbu         &lt;= '0';
        s_sw          &lt;= '0';
        s_sb          &lt;= '0';
        s_beq         &lt;= '0';
        s_bne         &lt;= '0';
        s_j           &lt;= '0';
        s_jal         &lt;= '0';
        s_jr          &lt;= '0';
        s_syscall     &lt;= '0';
        s_illegal     &lt;= '0';
        s_alu_op      &lt;= "000";

        if op = "000000" then
            case funct is
                when "100000" | "100001" =&gt;
                    s_R      &lt;= '1';
                    s_alu_op &lt;= "000";
                when "100010" =&gt;
                    s_R      &lt;= '1';
                    s_alu_op &lt;= "001";
                when "100100" =&gt;
                    s_R      &lt;= '1';
                    s_alu_op &lt;= "010";
                when "100101" =&gt;
                    s_R      &lt;= '1';
                    s_alu_op &lt;= "011";
                when "101010" =&gt;
                    s_R      &lt;= '1';
                    s_alu_op &lt;= "100";
                when "000000" =&gt;
                    s_R      &lt;= '1';
                    s_alu_op &lt;= "101";
                when "000010" =&gt;
                    s_R      &lt;= '1';
                    s_alu_op &lt;= "110";
                when "001000" =&gt;
                    s_jr &lt;= '1';
                when "001100" =&gt;
                    s_syscall &lt;= '1';
                when others =&gt;
                    s_illegal &lt;= '1';
            end case;
        elsif op = "001000" or op = "001001" then
            s_addi_type &lt;= '1';
            s_alu_op    &lt;= "000";
        elsif op = "001010" then
            s_addi_type &lt;= '1';
            s_alu_op    &lt;= "100";
        elsif op = "001100" then
            s_logical_imm &lt;= '1';
            s_alu_op      &lt;= "010";
        elsif op = "001101" then
            s_logical_imm &lt;= '1';
            s_alu_op      &lt;= "011";
        elsif op = "001111" then
            s_lui &lt;= '1';
        elsif op = "100011" then
            s_lw &lt;= '1';
        elsif op = "100000" then
            s_lb &lt;= '1';
        elsif op = "100100" then
            s_lbu &lt;= '1';
        elsif op = "101011" then
            s_sw &lt;= '1';
        elsif op = "101000" then
            s_sb &lt;= '1';
        elsif op = "000100" then
            s_beq &lt;= '1';
        elsif op = "000101" then
            s_bne &lt;= '1';
        elsif op = "000010" then
            s_j &lt;= '1';
        elsif op = "000011" then
            s_jal &lt;= '1';
        else
            s_illegal &lt;= '1';
        end if;
    end process;

    is_R           &lt;= s_R;
    is_addi_type   &lt;= s_addi_type;
    is_logical_imm &lt;= s_logical_imm;
    is_lui         &lt;= s_lui;
    is_lw          &lt;= s_lw;
    is_lb          &lt;= s_lb;
    is_lbu         &lt;= s_lbu;
    is_sw          &lt;= s_sw;
    is_sb          &lt;= s_sb;
    is_beq         &lt;= s_beq;
    is_bne         &lt;= s_bne;
    is_j           &lt;= s_j;
    is_jal         &lt;= s_jal;
    is_jr          &lt;= s_jr;
    is_syscall     &lt;= s_syscall;
    is_illegal     &lt;= s_illegal;
    alu_op_R       &lt;= s_alu_op;
    imm_zero_ext   &lt;= s_logical_imm;
    load_unsigned  &lt;= s_lbu;
    mem_byte       &lt;= s_lb or s_lbu or s_sb;
end architecture Behavioral;</vhdl>
  <vhdl appearance="logisim_evolution" name="Register_File">library ieee;
use ieee.std_logic_1164.all;
use ieee.numeric_std.all;

entity Register_File is
    port (
        clk        : in  std_logic;
        reset      : in  std_logic;
        RegWrite   : in  std_logic;
        read_rs    : in  std_logic_vector(4 downto 0);
        read_rt    : in  std_logic_vector(4 downto 0);
        write_rd   : in  std_logic_vector(4 downto 0);
        write_data : in  std_logic_vector(31 downto 0);
        rd1        : out std_logic_vector(31 downto 0);
        rd2        : out std_logic_vector(31 downto 0);
        v0_out     : out std_logic_vector(31 downto 0);
        a0_out     : out std_logic_vector(31 downto 0)
    );
end entity Register_File;

architecture Behavioral of Register_File is
    type reg_array is array (0 to 31) of std_logic_vector(31 downto 0);
    signal registers : reg_array := (28 =&gt; x"00001800", 29 =&gt; x"00003FFC", others =&gt; (others =&gt; '0'));
begin
    process (clk, reset)
    begin
        if reset = '1' then
            registers &lt;= (others =&gt; (others =&gt; '0'));
            registers(28) &lt;= x"00001800";
            registers(29) &lt;= x"00003FFC";
        elsif rising_edge(clk) then
            if RegWrite = '1' and to_integer(unsigned(write_rd)) /= 0 then
                registers(to_integer(unsigned(write_rd))) &lt;= write_data;
            end if;
        end if;
    end process;

    rd1    &lt;= registers(to_integer(unsigned(read_rs)));
    rd2    &lt;= registers(to_integer(unsigned(read_rt)));
    v0_out &lt;= registers(2);
    a0_out &lt;= registers(4);
end architecture Behavioral;</vhdl>
</project>
