    <wire from="(890,420)" to="(930,420)"/>
    <wire from="(890,500)" to="(930,500)"/>
    <wire from="(90,390)" to="(120,390)"/>
    <wire from="(90,420)" to="(100,420)"/>
    <wire from="(90,490)" to="(120,490)"/>
    <wire from="(90,520)" to="(100,520)"/>
  </circuit>
  <vhdl appearance="logisim_evolution" name="Instruiction_Decoder">library IEEE;
use IEEE.STD_LOGIC_1164.ALL;

entity Instruiction_Decoder is
    Port (
        instr    : in  STD_LOGIC_VECTOR (31 downto 0);
        opcode   : out STD_LOGIC_VECTOR (5 downto 0);
        rs       : out STD_LOGIC_VECTOR (4 downto 0);
        rt       : out STD_LOGIC_VECTOR (4 downto 0);
        rd       : out STD_LOGIC_VECTOR (4 downto 0);
        shamt    : out STD_LOGIC_VECTOR (4 downto 0);
        funct    : out STD_LOGIC_VECTOR (5 downto 0);
        imm16    : out STD_LOGIC_VECTOR (15 downto 0)
    );
end Instruiction_Decoder;

architecture Behavioral of Instruiction_Decoder is
begin
    opcode   &lt;= instr(31 downto 26);
    rs       &lt;= instr(25 downto 21);
    rt       &lt;= instr(20 downto 16);
    rd       &lt;= instr(15 downto 11);
    shamt    &lt;= instr(10 downto 6);
    funct    &lt;= instr(5 downto 0);
    imm16    &lt;= instr(15 downto 0);
end Behavioral;</vhdl>
  <vhdl appearance="logisim_evolution" name="Register_File">library IEEE;
use IEEE.STD_LOGIC_1164.ALL;
use IEEE.NUMERIC_STD.ALL;

entity Register_File is
    Port (
        clk        : in  STD_LOGIC;
        reset      : in  STD_LOGIC;
        RegWrite   : in  STD_LOGIC;
        read_rs    : in  STD_LOGIC_VECTOR (4 downto 0);
        read_rt    : in  STD_LOGIC_VECTOR (4 downto 0);
        write_rd   : in  STD_LOGIC_VECTOR (4 downto 0);
        write_data : in  STD_LOGIC_VECTOR (31 downto 0);
        rd1        : out STD_LOGIC_VECTOR (31 downto 0);
        rd2        : out STD_LOGIC_VECTOR (31 downto 0)
    );
end Register_File;

architecture Behavioral of Register_File is
    -- Banco de 32 registros de 32 bits
    type reg_array is array (0 to 31) of STD_LOGIC_VECTOR(31 downto 0);
    signal registers : reg_array := (others =&gt; (others =&gt; '0'));
begin

    -- Escritura síncrona en el flanco de subida del reloj
    process(clk, reset)
    begin
        if reset = '1' then
            registers &lt;= (others =&gt; (others =&gt; '0'));
        elsif rising_edge(clk) then
            -- El registro 0 ($0) nunca se puede sobrescribir
            if RegWrite = '1' and to_integer(unsigned(write_rd)) /= 0 then
                registers(to_integer(unsigned(write_rd))) &lt;= write_data;
            end if;
        end if;
    end process;

    -- Lectura combinacional de los puertos rs y rt (el registro $0 siempre retorna 0)
    rd1 &lt;= (others =&gt; '0') when to_integer(unsigned(read_rs)) = 0 else registers(to_integer(unsigned(read_rs)));
    rd2 &lt;= (others =&gt; '0') when to_integer(unsigned(read_rt)) = 0 else registers(to_integer(unsigned(read_rt)));

end Behavioral;</vhdl>
</project>
