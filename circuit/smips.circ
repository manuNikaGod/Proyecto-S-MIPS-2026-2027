  <vhdl appearance="logisim_evolution" name="Instruction_Decoder">library IEEE;
use IEEE.STD_LOGIC_1164.ALL;
use IEEE.NUMERIC_STD.ALL;

entity Instruction_Decoder is
    Port (
        instr          : in  STD_LOGIC_VECTOR (31 downto 0);
        opcode         : out STD_LOGIC_VECTOR (5 downto 0);
        rs             : out STD_LOGIC_VECTOR (4 downto 0);
        rt             : out STD_LOGIC_VECTOR (4 downto 0);
        rd             : out STD_LOGIC_VECTOR (4 downto 0);
        shamt          : out STD_LOGIC_VECTOR (4 downto 0);
        funct          : out STD_LOGIC_VECTOR (5 downto 0);
        imm16          : out STD_LOGIC_VECTOR (15 downto 0);
        is_R           : out STD_LOGIC;
        is_addi_type   : out STD_LOGIC;
        is_logical_imm : out STD_LOGIC;
        is_lw          : out STD_LOGIC;
        is_sw          : out STD_LOGIC;
        is_lb          : out STD_LOGIC;
        is_lbu         : out STD_LOGIC;
        is_sb          : out STD_LOGIC;
        is_beq         : out STD_LOGIC;
        is_bne         : out STD_LOGIC;
        is_j           : out STD_LOGIC;
        is_jal         : out STD_LOGIC;
        is_jr          : out STD_LOGIC;
        is_syscall     : out STD_LOGIC;
        is_illegal     : out STD_LOGIC
    );
end Instruction_Decoder;

architecture Behavioral of Instruction_Decoder is
    signal op_s    : STD_LOGIC_VECTOR(5 downto 0);
    signal funct_s : STD_LOGIC_VECTOR(5 downto 0);
begin
    op_s    &lt;= instr(31 downto 26);
    funct_s &lt;= instr(5 downto 0);

    opcode &lt;= op_s;
    rs     &lt;= instr(25 downto 21);
    rt     &lt;= instr(20 downto 16);
    rd     &lt;= instr(15 downto 11);
    shamt  &lt;= instr(10 downto 6);
    funct  &lt;= funct_s;
    imm16  &lt;= instr(15 downto 0);

    process(op_s, funct_s)
    begin
        is_R &lt;= '0';
        is_addi_type &lt;= '0';
        is_logical_imm &lt;= '0';
        is_lw &lt;= '0';
        is_sw &lt;= '0';
        is_lb &lt;= '0';
        is_lbu &lt;= '0';
        is_sb &lt;= '0';
        is_beq &lt;= '0';
        is_bne &lt;= '0';
        is_j &lt;= '0';
        is_jal &lt;= '0';
        is_jr &lt;= '0';
        is_syscall &lt;= '0';
        is_illegal &lt;= '0';

        case op_s is
            when "000000" =&gt;
                case funct_s is
                    when "100000" | "100001" =&gt; is_R &lt;= '1';
                    when "100010"            =&gt; is_R &lt;= '1';
                    when "100100"            =&gt; is_R &lt;= '1';
                    when "100101"            =&gt; is_R &lt;= '1';
                    when "101010"            =&gt; is_R &lt;= '1';
                    when "000000"            =&gt; is_R &lt;= '1';
                    when "000010"            =&gt; is_R &lt;= '1';
                    when "001000"            =&gt; is_jr &lt;= '1';
                    when "001100"            =&gt; is_syscall &lt;= '1';
                    when others              =&gt; is_illegal &lt;= '1';
                end case;
            when "001000" | "001001" =&gt; is_addi_type &lt;= '1';
            when "001010"            =&gt; is_addi_type &lt;= '1';
            when "001100" | "001101" =&gt; is_logical_imm &lt;= '1';
            when "001111"            =&gt; is_logical_imm &lt;= '1';
            when "100011"            =&gt; is_lw &lt;= '1';
            when "101011"            =&gt; is_sw &lt;= '1';
            when "100000"            =&gt; is_lb &lt;= '1';
            when "100100"            =&gt; is_lbu &lt;= '1';
            when "101000"            =&gt; is_sb &lt;= '1';
            when "000100"            =&gt; is_beq &lt;= '1';
            when "000101"            =&gt; is_bne &lt;= '1';
            when "000010"            =&gt; is_j &lt;= '1';
            when "000011"            =&gt; is_jal &lt;= '1';
            when others              =&gt; is_illegal &lt;= '1';
        end case;
    end process;

end Behavioral;</vhdl>
  <vhdl appearance="logisim_evolution" name="Register_File">library IEEE;
use IEEE.STD_LOGIC_1164.ALL;
use IEEE.NUMERIC_STD.ALL;

entity Register_File is
    Port (
        clk        : in  STD_LOGIC;
        reset      : in  STD_LOGIC;
        RegWrite   : in  STD_LOGIC;
        read_rs    : in  STD_LOGIC_VECTOR (4 downto 0);
        read_rt    : in  STD_LOGIC_VECTOR (4 downto 0);
        write_rd   : in  STD_LOGIC_VECTOR (4 downto 0);
        write_data : in  STD_LOGIC_VECTOR (31 downto 0);
        rd1        : out STD_LOGIC_VECTOR (31 downto 0);
        rd2        : out STD_LOGIC_VECTOR (31 downto 0)
    );
end Register_File;

architecture Behavioral of Register_File is
    type reg_array is array (0 to 31) of STD_LOGIC_VECTOR(31 downto 0);
    signal registers : reg_array := (
        28 =&gt; X"00001800", -- $gp inicial [R6]
        29 =&gt; X"00003FFC", -- $sp inicial [R6]
        others =&gt; (others =&gt; '0')
    );
begin

    process(clk, reset)
    begin
        if reset = '1' then
            registers &lt;= (others =&gt; (others =&gt; '0'));
            registers(28) &lt;= X"00001800"; -- $gp = 0x00001800 [R6]
            registers(29) &lt;= X"00003FFC"; -- $sp = 0x00003FFC [R6]
        elsif rising_edge(clk) then
            if RegWrite = '1' and to_integer(unsigned(write_rd)) /= 0 then
                registers(to_integer(unsigned(write_rd))) &lt;= write_data;
            end if;
        end if;
    end process;

    rd1 &lt;= (others =&gt; '0') when to_integer(unsigned(read_rs)) = 0 else registers(to_integer(unsigned(read_rs)));
    rd2 &lt;= (others =&gt; '0') when to_integer(unsigned(read_rt)) = 0 else registers(to_integer(unsigned(read_rt)));

end Behavioral;</vhdl>
</project>
